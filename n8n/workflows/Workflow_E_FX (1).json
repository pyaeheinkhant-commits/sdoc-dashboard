{
  "name": "Workflow_E_FX",
  "nodes": [
    {
      "parameters": {
        "content": "## Workflow E: Resolution follow-up\nMISMATCH_FOUND → draft correction → human approval → export message → CORRECTION_REQUESTED → new document → reprocess → RESOLVED or another review case.\n\nApproval webhook:\n```json\n{ \"decision\": \"APPROVE\", \"reviewer\": \"ops\" }\n```\nNew document webhook:\n```json\n{ \"replacement_email_id\": \"email_052\" }\n```",
        "height": 340,
        "width": 440
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        0,
        0
      ],
      "typeVersion": 1,
      "id": "0343f2bc-7908-4c83-8124-07fac5902e71",
      "name": "Sticky Note"
    },
    {
      "parameters": {},
      "id": "d2f455a1-547a-402e-9c26-80e0a886a558",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        208,
        256
      ]
    },
    {
      "parameters": {
        "inputSource": "passthrough"
      },
