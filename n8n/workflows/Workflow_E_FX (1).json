        "supabaseApi": {
          "id": "G3xRFJepVtxXoG3T",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "emails",
        "limit": 1,
        "filters": {
          "conditions": [
            {
              "keyName": "email_id",
              "condition": "eq",
              "keyValue": "={{ $('Normalize Input').item.json.email_id }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        656,
        480
      ],
      "id": "263a8cc2-e3a7-4611-b8d1-b022c36ced0a",
      "name": "Get Email",
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "G3xRFJepVtxXoG3T",
          "name": "Supabase account"
        }
