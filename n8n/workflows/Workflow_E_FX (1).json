    {
      "parameters": {
        "jsCode": "const input = $('Normalize Input').item.json;\nconst comparison = $('Get Comparison').item.json ?? {};\nconst email = $('Get Email').item.json ?? {};\nconst sameComparison = String(comparison.email_id ?? '') === String(input.email_id);\nconst sameEmail = String(email.email_id ?? '') === String(input.email_id);\n\nconst sender = sameEmail ? String(email.sender ?? '') : String(input.sender ?? input.from ?? '');\nconst subject = sameEmail ? String(email.subject ?? '') : String(input.subject ?? '');\nconst defectFields = sameComparison\n  ? (Array.isArray(comparison.defect_fields) ? comparison.defect_fields : [])\n  : (Array.isArray(input.defect_fields) ? input.defect_fields : []);\nconst summary = String(comparison.comparison_summary ?? input.comparison_summary ?? '');\n\nconst prompt = `You are SDOC, a shipping-operations assistant.\nDraft a short correction request email about SI vs draft BL mismatches.\n\nReturn exactly one JSON object. No Markdown.\n{\n  \"to\": \"recipient@example.com\",\n  \"subject\": \"short subject\",\n  \"body\": \"email body\",\n  \"recommended_action\": \"Request corrected draft BL\"\n}\n\nRules:\n- Do not invent extra defects.\n- Ask the sender to send a corrected document.\n- Keep a professional operations tone.\n- Mention only these mismatched fields: ${defectFields.join(', ') || 'unspecified fields'}.\n\nTO: ${sender}\nORIGINAL SUBJECT: ${subject}\nEMAIL ID: ${input.email_id}\nMISMATCH SUMMARY: ${summary}\nDEFECT FIELDS: ${JSON.stringify(defectFields)}`;\n\nreturn [{\n  json: {\n    ...input,\n    sender,\n    subject,\n    defect_fields: defectFields,\n    comparison_summary: summary,\n    gemini_body: {\n      contents: [{ role: 'user', parts: [{ text: prompt }] }],\n    },\n  },\n}];"
      },
      "id": "9f784d82-a51a-4cd4-aa05-fc0e8d9ce289",
      "name": "Build Draft Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        336
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "groqApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"openai/gpt-oss-20b\",\n  messages: [\n    {\n      role: \"user\",\n      content: $json.gemini_body.contents[0].parts[0].text\n    }\n  ],\n  temperature: 0.1,\n  reasoning_format: \"hidden\",\n  response_format: {\n    type: \"json_object\"\n  }\n}) }}",
        "options": {}
      },
      "id": "87ca8149-ffd7-4749-ba44-b4b971d0a89e",
      "name": "Groq Draft Correction",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1104,
        336
      ],
      "credentials": {
        "groqApi": {
          "id": "Qea8plC3oy2vtLd9",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const source = $('Build Draft Request').item.json;\nconst rawText = String($json.choices?.[0]?.message?.content ?? '').trim();\nif (!rawText) {\n  throw new Error(`Groq returned no draft. Response: ${JSON.stringify($json).slice(0, 500)}`);\n}\nconst jsonText = rawText.match(/\\{[\\s\\S]*\\}/)?.[0];\nif (!jsonText) {\n  throw new Error(`Groq did not return JSON: ${rawText.slice(0, 500)}`);\n}\nlet result;\ntry {\n  result = JSON.parse(jsonText);\n} catch {\n  throw new Error(`Groq returned invalid JSON: ${rawText.slice(0, 500)}`);\n}\n\nconst draft = {\n  email_id: source.email_id,\n  to_address: String(result.to ?? source.sender ?? ''),\n  subject: String(result.subject ?? `Correction needed: ${source.subject}`),\n  body: String(result.body ?? ''),\n  defect_fields: Array.isArray(source.defect_fields) ? source.defect_fields : [],\n  defect_fields_text: JSON.stringify(source.defect_fields ?? []),\n  recommended_action: String(result.recommended_action ?? 'Request corrected draft BL'),\n  status: 'DRAFT',\n  approval_webhook_url: $execution.resumeUrl ?? '',\n  event_type: 'DRAFT_CORRECTION_CREATED',\n  actor_type: 'ai',\n  details_json_text: jsonText,\n};\nif (!draft.body) {\n  throw new Error('Draft correction body was empty');\n}\nreturn [{ json: draft }];"
      },
