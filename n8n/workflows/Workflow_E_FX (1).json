        432
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json ?? {};\nconst emailId = String(raw.email_id ?? raw['Email ID'] ?? '').trim() || 'email_051';\nif (!/^email_\\d{3}$/.test(emailId)) {\n  throw new Error('Enter an email ID such as email_051');\n}\nreturn [{ json: { ...raw, email_id: emailId } }];"
      },
      "id": "9087a683-b4ea-42d8-9385-4c6180cc8c4e",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        432,
        336
      ]
    },
    {
