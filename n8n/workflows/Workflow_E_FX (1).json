      "parameters": {
        "jsCode": "const draft = $('Validate Draft JSON').item.json;\nconst body = $json ?? {};\nconst decision = String(body.decision ?? body.approval ?? '')\n  .trim()\n  .toUpperCase();\nconst allowed = new Set(['APPROVE', 'REJECT']);\nif (!allowed.has(decision)) {\n  throw new Error('POST JSON with decision: APPROVE or REJECT');\n}\nreturn [{\n  json: {\n    ...draft,\n    approval_decision: decision,\n    reviewer_comment: String(body.comment ?? ''),\n    assigned_to: String(body.reviewer ?? 'dashboard_reviewer'),\n    status: decision === 'APPROVE' ? 'APPROVED' : 'REJECTED',\n    event_type: decision === 'APPROVE' ? 'CORRECTION_APPROVED' : 'CORRECTION_REJECTED',\n    actor_type: 'human',\n    actor_id: String(body.reviewer ?? 'dashboard_reviewer'),\n    details_json_text: JSON.stringify({ decision, comment: body.comment ?? '' }),\n  },\n}];"
      },
