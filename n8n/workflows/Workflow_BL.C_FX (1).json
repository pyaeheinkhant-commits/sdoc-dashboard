    {
      "parameters": {
        "jsCode": "const source = $items('Build Comparison Request')[0].json;\nconst raw = ($json.candidates?.[0]?.content?.parts ?? []).map((p) => p.text ?? '').join('\\n');\nconst match = raw.match(/\\{[\\s\\S]*\\}/);\nlet result = {};\ntry { result = match ? JSON.parse(match[0]) : {}; } catch {}\nconst fields = new Set(['shipper','consignee','notify_party','port_of_loading','port_of_discharge','container_count','gross_weight_kg']);\nconst statuses = new Set(['OK','MISMATCH','NEEDS_REVIEW']);\nconst status = statuses.has(result.status) ? result.status : 'NEEDS_REVIEW';\nconst defectFields = Array.isArray(result.defect_fields) ? result.defect_fields.filter((f) => fields.has(f)) : [];\nconst reasons = new Set(['wrong_doc_type','missing_attachment','unreadable','missing_value']);\nconst reviewReason = status === 'NEEDS_REVIEW' ? (reasons.has(result.review_reason) ? result.review_reason : 'unreadable') : null;\nreturn [{ json: { email_id: source.email_id, sender: source.sender, subject: source.subject, category: 'BL_COMPARISON', status, review_reason: reviewReason, has_defect: status === 'MISMATCH', defect_fields: status === 'MISMATCH' ? defectFields : [], comparison_summary: String(result.comparison_summary ?? ''), processed_at: new Date().toISOString() } }];"
      },
