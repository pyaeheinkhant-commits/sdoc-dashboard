      "parameters": {
        "jsCode": "const files = Array.isArray($json.attachments) ? $json.attachments : [];\n\nconst supported = /\\.(txt|xlsx|docx|pdf)$/i;\n\nconst siPath = files.find(\n  (path) => /(?:^|[_-])SI\\.(txt|xlsx|docx|pdf)$/i.test(String(path))\n);\n\nconst blPath = files.find(\n  (path) => /(?:^|[_-])BL\\.(txt|xlsx|docx|pdf)$/i.test(String(path))\n);\n\nif (!siPath || !blPath) {\n  throw new Error(\n    `Missing SI or BL. Attachments found: ${files.join(', ')}`\n  );\n}\n\nconst getType = (path) =>\n  String(path).split('.').pop().toLowerCase();\n\nreturn [\n  {\n    json: {\n      ...$json,\n      si_path: siPath,\n      bl_path: blPath,\n      si_type: getType(siPath),\n      bl_type: getType(blPath),\n    },\n  },\n];"
      },
