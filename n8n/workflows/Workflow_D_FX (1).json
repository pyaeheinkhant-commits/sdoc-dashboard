    {
      "parameters": {
        "jsCode": "const original = $('Parse Reviewer Decision').item.json;\nconst result = $json ?? {};\nconst status = String(result.status ?? '').toUpperCase();\nconst stillNeedsReview = status === 'NEEDS_REVIEW';\nconst mismatch = status === 'MISMATCH' || status === 'MISMATCH_FOUND';\nreturn [{\n  json: {\n    ...original,\n    email_id: original.email_id,\n    retry_status: status || 'UNKNOWN',\n    still_needs_review: stillNeedsReview,\n    retry_is_mismatch: mismatch,\n    review_status: stillNeedsReview ? 'OPEN' : (mismatch ? 'RESOLVED' : 'RESOLVED'),\n    email_status: stillNeedsReview ? 'NEEDS_REVIEW' : (mismatch ? 'MISMATCH_FOUND' : (status || 'OK')),\n    comparison_status: stillNeedsReview ? 'NEEDS_REVIEW' : (mismatch ? 'MISMATCH' : (status || 'OK')),\n    next: stillNeedsReview ? 'DONE' : (mismatch ? 'CALL_E' : 'DONE'),\n    event_type: 'RETRY_COMPLETE',\n    details_json_text: JSON.stringify({ retry_status: status }),\n  },\n}];"
      },
