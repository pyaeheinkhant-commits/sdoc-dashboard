    {
      "parameters": {
        "jsCode": "const opened = $('Build Review Case').item.json;\nconst body = $json ?? {};\nconst decision = String(body.decision ?? body.reviewer_decision ?? '')\n  .trim()\n  .toUpperCase();\nconst allowed = new Set(['CONFIRM_OK', 'CONFIRM_MISMATCH', 'RETRY', 'CLOSE']);\nif (!allowed.has(decision)) {\n  throw new Error(\n    `Invalid decision \"${decision}\". POST JSON with decision: CONFIRM_OK, CONFIRM_MISMATCH, RETRY, or CLOSE.`\n  );\n}\n\nconst now = new Date().toISOString();\nconst map = {\n  CONFIRM_OK: {\n    review_status: 'RESOLVED',\n    email_status: 'OK',\n    comparison_status: 'OK',\n    has_defect: false,\n    next: 'DONE',\n    resolved_at: now,\n  },\n  CONFIRM_MISMATCH: {\n    review_status: 'RESOLVED',\n    email_status: 'MISMATCH_FOUND',\n    comparison_status: 'MISMATCH',\n    has_defect: true,\n    next: 'CALL_E',\n    resolved_at: now,\n  },\n  RETRY: {\n    review_status: 'RETRYING',\n    email_status: 'PROCESSING',\n    comparison_status: 'PROCESSING',\n    has_defect: false,\n    next: 'RETRY',\n    resolved_at: null,\n  },\n  CLOSE: {\n    review_status: 'CLOSED',\n    email_status: 'CLOSED',\n    comparison_status: String(opened.evidence_json?.comparison_status ?? 'NEEDS_REVIEW'),\n    has_defect: Boolean(opened.evidence_json?.has_defect),\n    next: 'DONE',\n    resolved_at: now,\n  },\n};\n\nconst mapped = map[decision];\nreturn [{\n  json: {\n    ...opened,\n    reviewer_decision: decision,\n    reviewer_comment: String(body.comment ?? body.reviewer_comment ?? ''),\n    assigned_to: String(body.reviewer ?? body.assigned_to ?? 'dashboard_reviewer'),\n    ...mapped,\n    event_type: 'REVIEWER_DECISION',\n    actor_type: 'human',\n    actor_id: String(body.reviewer ?? body.assigned_to ?? 'dashboard_reviewer'),\n    details_json_text: JSON.stringify({\n      decision,\n      comment: body.comment ?? body.reviewer_comment ?? '',\n    }),\n  },\n}];"
      },
