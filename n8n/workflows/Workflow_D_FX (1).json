    {
      "parameters": {
        "jsCode": "const input = $('Normalize Input').item.json;\nconst comparison = $('Get Comparison').item.json ?? {};\nconst email = $('Get Email').item.json ?? {};\n\nconst sameComparison = String(comparison.email_id ?? '') === String(input.email_id);\nconst sameEmail = String(email.email_id ?? '') === String(input.email_id);\n\nconst reviewReason = String(\n  (sameComparison ? comparison.review_reason : input.review_reason) ?? 'unreadable'\n);\nconst comparisonStatus = String(\n  (sameComparison ? comparison.status : input.status) ?? 'NEEDS_REVIEW'\n);\nconst defectFields = sameComparison\n  ? (Array.isArray(comparison.defect_fields) ? comparison.defect_fields : [])\n  : (Array.isArray(input.defect_fields) ? input.defect_fields : []);\n\nconst evidence = {\n  email_id: input.email_id,\n  sender: sameEmail ? email.sender : (input.sender ?? input.from ?? ''),\n  subject: sameEmail ? email.subject : (input.subject ?? ''),\n  body: sameEmail ? (email.body ?? '') : (input.clean_body ?? input.body ?? ''),\n  category: sameEmail ? email.category : (input.category ?? 'BL_COMPARISON'),\n  comparison_status: comparisonStatus,\n  review_reason: reviewReason,\n  has_defect: Boolean(sameComparison ? comparison.has_defect : input.has_defect),\n  defect_fields: defectFields,\n  comparison_summary: String(\n    comparison.comparison_summary ?? input.comparison_summary ?? ''\n  ),\n  recommended_action: 'Human verification of SI/BL evidence',\n};\n\nreturn [{\n  json: {\n    email_id: input.email_id,\n    comparison_id: sameComparison ? (comparison.id ?? null) : null,\n    review_reason: reviewReason,\n    evidence_json: evidence,\n    evidence_json_text: JSON.stringify(evidence),\n    status: 'OPEN',\n    assigned_to: '',\n    reviewer_decision: '',\n    reviewer_comment: '',\n    webhook_url: $execution.resumeUrl ?? '',\n    event_type: 'REVIEW_OPENED',\n    actor_type: 'system',\n    details_json_text: JSON.stringify({ review_reason: reviewReason, evidence }),\n  },\n}];"
      },
