        "jsCode": "const raw = $input.first().json ?? {};\nconst emailId = String(raw.email_id ?? raw['Email ID'] ?? '').trim() || 'email_050';\nif (!/^email_\\d{3}$/.test(emailId)) {\n  throw new Error('Enter an email ID such as email_050');\n}\nreturn [{ json: { ...raw, email_id: emailId } }];"
      },
