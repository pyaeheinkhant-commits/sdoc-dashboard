    {
      "parameters": {
        "jsCode": "const email = $('Remove Quoted History').item.json;\n\nconst emailId = String(email.email_id ?? '');\nconst sender = String(email.from ?? email.sender ?? '');\nconst subject = String(email.subject ?? '');\nconst body = String(email.clean_body ?? email.body ?? '');\nconst attachments = Array.isArray(email.attachments)\n  ? email.attachments.join(', ')\n  : '';\n\nif (!emailId) {\n  throw new Error('No email_id was received from Remove Quoted History');\n}\n\nconst prompt = `You are SDOC, a shipping-operations email classifier.\n\nReturn exactly one valid JSON object. No Markdown. No explanation outside JSON.\n\nChoose exactly one category:\nBL_COMPARISON, SI_REQUEST, INVOICE_QUERY, GENERAL, SPAM.\n\nDefinitions:\n- BL_COMPARISON: asks to compare/check a Shipping Instruction (SI) against a draft Bill of Lading (BL).\n- SI_REQUEST: asks for SI instructions, a new SI, or a draft BL without comparison.\n- INVOICE_QUERY: billing, invoice, freight charge, payment, or cost question.\n- GENERAL: genuine shipping operation email that does not fit above.\n- SPAM: irrelevant promotion, scam, phishing, or junk.\n\nRequired JSON format:\n{\n  \"category\": \"GENERAL\",\n  \"category_confidence\": 0.0,\n  \"classification_reason\": \"short reason\"\n}\n\nEMAIL ID: ${emailId}\nFROM: ${sender}\nSUBJECT: ${subject}\nBODY:\n${body}\n\nATTACHMENTS: ${attachments}`;\n\nreturn [\n  {\n    json: {\n      ...email,\n      gemini_body: {\n        contents: [\n          {\n            role: 'user',\n            parts: [\n              { text: prompt },\n            ],\n          },\n        ],\n      },\n    },\n  },\n];"
      },
      "id": "586da69f-19ec-4da6-942d-7d4d6483aeb0",
      "name": "Build Classification Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1808,
        432
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "groqApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"openai/gpt-oss-20b\",\n  messages: [\n    {\n      role: \"user\",\n      content: $json.gemini_body.contents[0].parts[0].text\n    }\n  ],\n  temperature: 0.1,\n  reasoning_format: \"hidden\",\n  response_format: {\n    type: \"json_object\"\n  }\n}) }}",
        "options": {}
      },
      "id": "6f45d529-8844-4b51-b49e-efab6d249856",
      "name": "Groq Classify Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1584,
        432
