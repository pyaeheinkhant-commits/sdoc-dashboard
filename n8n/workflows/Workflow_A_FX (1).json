        "jsCode": "const emailId = String($json.email_id ?? '');\nconst match = emailId.match(/^email_(\\d+)$/i);\n\nif (!match) {\n  throw new Error(`Cannot find email number in email_id: ${emailId}`);\n}\n\nconst emailNumber = Number(match[1]);\n\nreturn [\n  {\n    json: {\n      ...$json,\n      email_number: emailNumber,\n      pause_after_batch: emailNumber % 10 === 0,\n    },\n  },\n];"
