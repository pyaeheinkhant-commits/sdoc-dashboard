          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const source = $('Remove Quoted History').item.json;\n\nconst rawText = String(\n  $json.choices?.[0]?.message?.content ?? ''\n).trim();\n\nif (!rawText) {\n  throw new Error(\n    `Groq returned no message content. Response: ${JSON.stringify($json).slice(0, 500)}`\n  );\n}\n\nconst jsonText = rawText.match(/\\{[\\s\\S]*\\}/)?.[0];\n\nif (!jsonText) {\n  throw new Error(`Groq did not return JSON: ${rawText.slice(0, 500)}`);\n}\n\nlet result;\ntry {\n  result = JSON.parse(jsonText);\n} catch {\n  throw new Error(`Groq returned invalid JSON: ${rawText.slice(0, 500)}`);\n}\n\nconst validCategories = new Set([\n  'BL_COMPARISON',\n  'SI_REQUEST',\n  'INVOICE_QUERY',\n  'GENERAL',\n  'SPAM',\n]);\n\nconst category = String(result.category ?? '')\n  .trim()\n  .toUpperCase();\n\nif (!validCategories.has(category)) {\n  throw new Error(\n    `Invalid category from Groq: \"${result.category}\". Raw answer: ${rawText.slice(0, 500)}`\n  );\n}\n\nreturn [\n  {\n    json: {\n      ...source,\n      category,\n      category_confidence: Number(result.category_confidence ?? 0),\n      classification_reason: String(result.classification_reason ?? ''),\n      status: 'CLASSIFIED',\n      review_reason: null,\n      has_defect: false,\n      defect_fields: [],\n    },\n  },\n];"
      },
