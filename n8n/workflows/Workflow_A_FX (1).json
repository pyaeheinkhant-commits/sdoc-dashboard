      "parameters": {
        "jsCode": "const original = $('Switch').item.json;\nconst stored = $json ?? {};\n\nconst completedStatuses = new Set([\n  'OK',\n  'MISMATCH',\n  'NEEDS_REVIEW',\n]);\n\nconst sameEmail =\n  String(stored.email_id ?? '') === String(original.email_id ?? '');\n\nconst comparisonDone =\n  sameEmail &&\n  String(stored.category ?? '') === 'BL_COMPARISON' &&\n  completedStatuses.has(String(stored.status ?? ''));\n\nreturn [\n  {\n    json: {\n      ...original,\n\n      // Use the stored final result only when comparison is truly complete\n      ...(comparisonDone\n        ? {\n            status: stored.status,\n            review_reason: stored.review_reason,\n            has_defect: stored.has_defect,\n            defect_fields: stored.defect_fields,\n            comparison_summary: stored.comparison_summary,\n          }\n        : {}),\n\n      comparison_done: comparisonDone,\n    },\n  },\n];"
      },
